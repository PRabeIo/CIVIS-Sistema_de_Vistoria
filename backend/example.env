PORT=3001

# Banco local (docker compose up -d db). Para Supabase, use a connection string do projeto
# e DATABASE_SSL=require.
DATABASE_URL=postgres://civis:civis@127.0.0.1:55432/civis
DATABASE_SSL=disable

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

JWT_SECRET=sua_chave_jwt
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

GEMINI_API_KEY=SUA_CHAVE_AQUI

# Senha dos usuários criados por "npm run seed" (só dev/teste).
# SEED_PASSWORD=
